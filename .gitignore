# ==== BACK_END SPECIFIC ====

# Django migrations (optional - uncomment if you don't want to track migrations)
# back_end/*/migrations/*.py
# back_end/*/migrations/*.pyc

# Django media files
back_end/media/
back_end/static/
back_end/staticfiles/

# Django secret key and settings
back_end/*/settings/local.py
back_end/*/settings/production.py

# Database
back_end/*.sqlite3
back_end/*.db

# Logs
back_end/logs/
back_end/*.log

# ==== FRONT_END SPECIFIC (Android) ====

# Built application files
front_end/*.apk
front_end/*.aar

# Files for the ART/Dalvik VM
front_end/*.dex

# Java class files
front_end/*.class

# Generated files
front_end/bin/
front_end/gen/
front_end/out/
front_end/build/
front_end/.gradle/

# Gradle files
front_end/.gradle/
front_end/build/

# Local configuration file (sdk path, etc)
front_end/local.properties

# Proguard folder generated by Eclipse
front_end/proguard/

# Log Files
front_end/*.log

# Android Studio Navigation editor temp files
front_end/.navigation/

# Android Studio captures folder
front_end/captures/

# IntelliJ
front_end/.idea/
front_end/*.iml
front_end/*.iws

# Keystore files
front_end/*.jks
front_end/*.keystore

# External native build folder generated in Android Studio 2.2 and later
front_end/.externalNativeBuild
front_end/.cxx/

# Google Services (e.g. APIs or Firebase)
front_end/google-services.json

# Freeline
front_end/freeline.py
front_end/freeline/
front_end/freeline_project_description.json

# fastlane
front_end/fastlane/report.xml
front_end/fastlane/Preview.html
front_end/fastlane/screenshots
front_end/fastlane/test_output
front_end/fastlane/readme.md

# Version control
front_end/.git/

# OS-specific files
front_end/.DS_Store

# ==== TEMPORARY AND BACKUP FILES ====
*.tmp
*.bak
*.swp
*~.nib

